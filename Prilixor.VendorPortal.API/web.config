<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <!-- Remove WebDAVModule to allow PUT and DELETE verbs in IIS -->
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <!-- Remove WebDAV handler to allow PUT and DELETE verbs in IIS -->
      <remove name="WebDAV" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\Prilixor.VendorPortal.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>
</configuration>
