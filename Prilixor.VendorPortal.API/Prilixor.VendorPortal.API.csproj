<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Prilixor.VendorPortal.Infrastructure\Prilixor.VendorPortal.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.5.3" />
    <PackageReference Include="FastEndpoints" Version="8.1.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d4cacd9b-a380-4964-a17c-1ff85195c88a</UserSecretsId>
    <!-- Publish a web.config configured for IIS out-of-process hosting (matches the live deployment). -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <!-- Git ignores this file, so it is not in source control. It still sits beside the project
       on the machine that holds live settings, and Release publish must copy it into the zip. -->
  <ItemGroup Condition="Exists('appsettings.Production.json')">
    <Content Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="EnsureProductionSettingsInPublish" BeforeTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('appsettings.Production.json')"
           Text="appsettings.Production.json is missing beside the API project. Release publish will not include live settings in the AWS zip." />
  </Target>

</Project>
